# ============================================================================
# Profile: cluster — N stateless app servers behind a load balancer.
#
# Lowest-precedence defaults for MODE=cluster. Anything here can be overridden in
# config/common.env or config/<env>.env. Do not edit this file to configure a
# deployment; edit config/<env>.env.
#
# Shape: the load balancer terminates TLS and health-checks each host; nginx on
# each host is an HTTP-only edge that trusts the LB's X-Forwarded-* headers.
# Postgres and Redis are managed services holding all durable state, so the app
# hosts are disposable and identical.
# ============================================================================

TLS_MODE=loadbalancer
POSTGRES_MODE=external
REDIS_MODE=external

# Managed Postgres / Redis defaults (DigitalOcean ports shown).
POSTGRES_PORT=25060
DB_SSL_MODE=require
REDIS_PORT=25061
REDIS_SSL=true
# Managed Redis presents a certificate whose CA is not in the public trust
# store, so verified TLS ('required') fails. 'none' keeps the connection
# encrypted without chain verification — prefer the provider's PRIVATE host so
# the unverified connection never leaves the VPC.
REDIS_SSL_CERT_REQS=none

# Celery Beat must run on exactly ONE host or every scheduled job fires twice.
# It is placed on PRIMARY_HOST only; this flag just enables it at all.
WITH_BEAT=true

API_WORKERS=4
CELERY_WORKERS=4

# Resource caps per container. Higher than single-server because these hosts run
# only the app — the databases are managed elsewhere.
API_MEM_LIMIT=1024m
API_CPUS=1.5
WORKER_MEM_LIMIT=768m
WORKER_CPUS=1.5
