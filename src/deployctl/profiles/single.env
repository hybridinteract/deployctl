# ============================================================================
# Profile: single — one server, self-contained.
#
# Lowest-precedence defaults for MODE=single. Anything here can be overridden in
# config/common.env or config/<env>.env. Do not edit this file to configure a
# deployment; edit config/<env>.env.
#
# Shape: nginx terminates TLS with a Let's Encrypt certificate obtained by a
# certbot container on the box; Postgres and Redis run as containers beside the
# app. Same pipeline as cluster mode — the image is still pulled from the
# registry, nothing is built on the server.
# ============================================================================

TLS_MODE=letsencrypt
POSTGRES_MODE=container
REDIS_MODE=container

# Containerized Postgres/Redis are reached by service name on the compose
# network. These are forced (not merely defaulted) when the matching *_MODE is
# 'container' — see cli/config.py.
POSTGRES_PORT=5432
DB_SSL_MODE=disable
REDIS_PORT=6379
REDIS_SSL=false

# One box runs everything, so it is always the primary: Beat + migrations.
WITH_BEAT=true

# Modest defaults — a single 2 vCPU / 2-4 GB box also hosts the database and the
# cache, so the app cannot have the whole machine. Raise these together with the
# server size; leaving them at cluster values on a small box invites OOM kills.
API_WORKERS=2
CELERY_WORKERS=2
API_MEM_LIMIT=768m
API_CPUS=1.0
WORKER_MEM_LIMIT=512m
WORKER_CPUS=1.0
POSTGRES_MEM_LIMIT=512m
POSTGRES_CPUS=1.0
REDIS_MEM_LIMIT=256m
