{#-
  The tool-owned half of the application environment.

  Only what deployctl actually knows about: where the database and cache are, what
  this environment is called, and the secrets it manages. Everything specific to
  your application — API keys, feature flags, tuning — belongs in
  project/app.env.template, which is appended after this block.

  This file is identical on every host in a deployment. Anything that must differ
  per host (which one runs the scheduler) is expressed in the compose file, not here.
-#}
# ============================================================================
# {{ PROJECT_NAME }} — {{ ENV_DISPLAY_NAME }} environment
#
# Generated by deployctl. Values below come from config/{{ ENV }}.env; edit there
# and re-run `deployctl setup --env {{ ENV }}`.
# ============================================================================

# -------- Runtime --------
ENVIRONMENT={{ ENV }}
DEBUG=false
LOG_LEVEL={{ LOG_LEVEL }}
ENABLE_DOCS={{ ENABLE_DOCS }}
API_WORKERS={{ API_WORKERS }}
API_PORT={{ APP_PORT }}

# -------- Application secrets --------
# Generated once into config/secrets.{{ ENV }}.env and reused on every regenerate.
# Rotating JWT_SECRET_KEY invalidates every issued token: deployctl setup --rotate-secrets
SECRET_KEY={{ SECRET_KEY }}
JWT_SECRET_KEY={{ JWT_SECRET_KEY }}

# -------- Database --------
{% if WITH_POSTGRES %}
# Runs as a container on this host; reachable only on the compose network.
{% else %}
# External managed database. Every deployment host must be in its trusted sources.
{% endif %}
POSTGRES_HOST={{ POSTGRES_HOST }}
POSTGRES_PORT={{ POSTGRES_PORT }}
POSTGRES_DB={{ POSTGRES_DB }}
POSTGRES_USER={{ POSTGRES_USER }}
POSTGRES_PASSWORD={{ POSTGRES_PASSWORD }}
DB_SSL_MODE={{ DB_SSL_MODE }}
{% if DATABASE_URL_SCHEME %}
# Convenience URL. If your driver is async (asyncpg), set DATABASE_URL_SCHEME to
# postgresql+asyncpg in project/project.env — and note asyncpg rejects ?sslmode=,
# it wants ssl=; build the URL in your settings from the parts above if so.
DATABASE_URL={{ DATABASE_URL }}
{% endif %}

# -------- Redis --------
{% if WITH_REDIS %}
# Runs as a container on this host: cache, Celery broker and result backend.
{% else %}
# External managed Redis shared by every host, so any worker can pick up any job.
{% endif %}
REDIS_HOST={{ REDIS_HOST }}
REDIS_PORT={{ REDIS_PORT }}
REDIS_DB={{ REDIS_DB }}
REDIS_PASSWORD={{ REDIS_PASSWORD }}
REDIS_SSL={{ REDIS_SSL }}
{% if REDIS_SSL == 'true' %}
# 'none' keeps the connection encrypted without verifying the chain. Managed Redis
# providers use a CA that is not in the public trust store, so 'required' fails
# unless you mount their CA into the image.
REDIS_SSL_CERT_REQS={{ REDIS_SSL_CERT_REQS }}
{% endif %}
REDIS_URL={{ REDIS_URL }}

# -------- Celery --------
{% if CELERY_APP %}
CELERY_BROKER_URL={{ CELERY_BROKER_URL }}
CELERY_RESULT_BACKEND={{ CELERY_RESULT_BACKEND }}
CELERY_WORKER_CONCURRENCY={{ CELERY_WORKERS }}
{% endif %}

# -------- HTTP --------
{% if TLS_LB %}
# This name resolves to the LOAD BALANCER, not to any individual host.
{% endif %}
API_DOMAIN={{ API_DOMAIN }}
API_URL={{ 'https' if TLS_LE or TLS_LB else 'http' }}://{{ API_DOMAIN }}
# JSON array: frameworks that validate the Host header read this.
TRUSTED_HOSTS={{ TRUSTED_HOSTS_LIST | tojson }}
CORS_ORIGINS={{ CORS_ORIGINS }}
