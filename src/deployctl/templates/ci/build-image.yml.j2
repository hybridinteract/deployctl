# Managed by deployctl «VERSION» — regenerate with: deployctl ci init --force
#
# Build and publish the application image. ci.yml calls this after its checks
# pass on a push to «DEPLOY_BRANCH»; a manual run or a v* tag builds without them.
#
#   «IMAGE_REPO»:<short-sha>          the api image
{% if WORKER_BUILD_TARGET %}
#   «IMAGE_REPO»:<short-sha>-worker   the «WORKER_BUILD_TARGET» stage, for the Celery containers —
#                                     built in the same run, so the two are never a commit apart
{% endif %}
#
# The tag it pushed is this workflow's `tag` output. The deploy job uses exactly
# that: recomputing it (`git rev-parse --short=7` prints more than seven
# characters when seven are ambiguous) can name an image that was never pushed.
#
# ONE repository setting is required or the push fails with
# "denied: permission_denied":
#   Settings → Actions → General → Workflow permissions → "Read and write permissions"

name: build-image

on:
  workflow_call:
    outputs:
      tag:
        description: The immutable image tag this run pushed (short commit SHA)
        value: ${{ jobs.build.outputs.tag }}
  push:
    tags: ["v*"]
  workflow_dispatch: {}

# Two pushes in quick succession would race, and both would write `latest`. A
# build that was going to publish an immutable tag is worth finishing.
concurrency:
  group: build-image-${{ github.ref }}
  cancel-in-progress: false

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      contents: read
      packages: write
    outputs:
      tag: ${{ steps.sha.outputs.short }}
    steps:
      - uses: actions/checkout@«ACTIONS.checkout» # «ACTIONS.checkout_version»
        with:
          persist-credentials: false

      # Pushes to «DEPLOY_BRANCH» and v* tags publish the plain short SHA — the form
      # `deployctl image tags` lists. Any other branch gets -dev appended: pullable
      # by name, never offered as a release.
      - name: Compute the image tag
        id: sha
        run: |
          short="$(git rev-parse --short=7 HEAD)"
          case "$GITHUB_REF" in
            refs/heads/«DEPLOY_BRANCH»|refs/tags/*) echo "short=$short" >> "$GITHUB_OUTPUT" ;;
            *) echo "short=$short-dev" >> "$GITHUB_OUTPUT" ;;
          esac

      - uses: docker/login-action@«ACTIONS.login» # «ACTIONS.login_version»
        with:
          registry: «REGISTRY_HOST»
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - uses: docker/setup-buildx-action@«ACTIONS.buildx» # «ACTIONS.buildx_version»

      - name: Build & push — api
        uses: docker/build-push-action@«ACTIONS.build_push» # «ACTIONS.build_push_version»
        with:
          context: «CI_BUILD_CONTEXT»
          file: «CI_DOCKERFILE»
{% if BUILD_TARGET %}
          target: «BUILD_TARGET»
{% endif %}
          platforms: «IMAGE_PLATFORM»
          push: true
          tags: |
            «IMAGE_REPO»:${{ steps.sha.outputs.short }}
            ${{ github.ref == 'refs/heads/«DEPLOY_BRANCH»' && '«IMAGE_REPO»:latest' || '' }}
          cache-from: type=gha,scope=api
          cache-to: type=gha,mode=max,scope=api
          # A provenance attestation turns the tag into a manifest index with an
          # `unknown/unknown` entry, which `docker manifest inspect` — how doctor
          # checks an image is pullable — reports confusingly.
          provenance: false
{% if WORKER_BUILD_TARGET %}

      # Reuses everything the api build just made; reads its cache as well as
      # its own, so a cache-only run stays fast.
      - name: Build & push — worker
        uses: docker/build-push-action@«ACTIONS.build_push» # «ACTIONS.build_push_version»
        with:
          context: «CI_BUILD_CONTEXT»
          file: «CI_DOCKERFILE»
          target: «WORKER_BUILD_TARGET»
          platforms: «IMAGE_PLATFORM»
          push: true
          tags: |
            «IMAGE_REPO»:${{ steps.sha.outputs.short }}-worker
            ${{ github.ref == 'refs/heads/«DEPLOY_BRANCH»' && '«IMAGE_REPO»:latest-worker' || '' }}
          cache-from: |
            type=gha,scope=worker
            type=gha,scope=api
          cache-to: type=gha,mode=max,scope=worker
          provenance: false
{% endif %}

      - name: Summary
        env:
          TAG: ${{ steps.sha.outputs.short }}
        run: |
          {
            echo "### Image published: \`${TAG}\`"
            echo ""
            echo "Deploy it: \`deployctl ci deploy --env «ENV» --tag ${TAG}\`"
          } >> "$GITHUB_STEP_SUMMARY"
