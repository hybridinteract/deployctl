# Build and publish the application image — generated by `deployctl ci init`.
#
# On every push to «DEPLOY_BRANCH» this builds «CI_DOCKERFILE» and pushes
#   «IMAGE_REPO»:<short-sha>   (plus :latest as a convenience pointer)
# using the workflow's own GITHUB_TOKEN — no secrets to configure.
#
# When the project sets WORKER_BUILD_TARGET, a second image
#   «IMAGE_REPO»:<short-sha>-worker
# is built from that stage and pushed in the same run, so the two can never be
# published a commit apart.
#
# ONE repository setting is required or the push fails with
# "denied: permission_denied":
#   Settings → Actions → General → Workflow permissions → "Read and write permissions"
#
# After a green run, the Summary shows the exact IMAGE_TAG to deploy.

name: build-image

on:
  push:
    branches: ["«DEPLOY_BRANCH»"]
  workflow_dispatch: {}

concurrency:
  group: build-image-${{ github.ref }}
  cancel-in-progress: false

permissions:
  contents: read
  packages: write

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Compute the image tag (git short SHA)
        id: meta
        # The deploy branch publishes the plain short SHA — the only form the
        # control panel's tag picker offers, newest first. A manual run from any
        # other branch gets -dev appended: pullable by name, never offered.
        run: |
          sha="$(git rev-parse --short HEAD)"
          if [ "$GITHUB_REF" = "refs/heads/«DEPLOY_BRANCH»" ]; then
            echo "tag=$sha" >> "$GITHUB_OUTPUT"
          else
            echo "tag=$sha-dev" >> "$GITHUB_OUTPUT"
          fi

      - uses: docker/setup-buildx-action@v3

      - name: Log in to «REGISTRY_HOST»
        uses: docker/login-action@v3
        with:
          registry: «REGISTRY_HOST»
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Build and push
        uses: docker/build-push-action@v6
        with:
          context: «CI_BUILD_CONTEXT»
          file: «CI_DOCKERFILE»
«BUILD_TARGET_LINE»
          platforms: «IMAGE_PLATFORM»
          push: true
          tags: |
            «IMAGE_REPO»:${{ steps.meta.outputs.tag }}
            ${{ github.ref == 'refs/heads/«DEPLOY_BRANCH»' && '«IMAGE_REPO»:latest' || '' }}
          cache-from: type=gha
          cache-to: type=gha,mode=max
          provenance: false
«WORKER_BUILD_STEP»

      - name: Deployment summary
        run: |
          {
            echo "## Image published"
            echo ""
            echo '```'
            echo "IMAGE_REPO=«IMAGE_REPO»"
            echo "IMAGE_TAG=${{ steps.meta.outputs.tag }}"
            echo '```'
            echo ""
            echo "Deploy it:"
            echo '```'
            echo "deployctl image tags                        # confirm it is visible"
            echo "# set IMAGE_TAG=${{ steps.meta.outputs.tag }} in deploy/config/<env>.env, then"
            echo "deployctl setup --env <env> && deployctl deploy update --env <env>"
            echo '```'
          } >> "$GITHUB_STEP_SUMMARY"
