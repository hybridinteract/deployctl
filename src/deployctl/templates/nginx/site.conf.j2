{#-
  The server block(s) for {{ API_DOMAIN }}.

  Two shapes:

  * TLS_LE — this host owns the certificate. Port 80 serves the ACME challenge and
    redirects everything else to 443; port 443 terminates TLS and proxies.
  * TLS_LB / none — a single HTTP server on port 80. It is the default_server so
    it also answers the load balancer's health check, which arrives addressed to
    the host's IP rather than the domain.

  The Host header differs between them on purpose, see proxy_host below.
-#}
{% set proxy_host = API_DOMAIN if TLS_LB else '$host' %}
# {{ API_DOMAIN }} — {{ ENV }}

upstream app_backend {
    # nginx resolves this once at config load and caches the address. When the app
    # container is recreated during a deploy it gets a NEW address on the compose
    # network, so nginx is reloaded after every app restart — without that it
    # serves 502s against a container that no longer exists.
    server api:{{ APP_PORT }} max_fails=3 fail_timeout=30s;
    keepalive 32;
}

{% if TLS_LE %}
# ---- Port 80: ACME challenge, everything else redirected ----
# default_server so a request whose Host matches NO server_name still lands here.
# Without it the default for :80 is whichever block nginx sees first, and the
# nginx image ships /etc/nginx/conf.d/default.conf — which sorts before site.conf
# and serves /usr/share/nginx/html. Every unmatched Host then 404s, including the
# ACME challenge for a domain that was just changed but whose config the running
# container has not picked up yet: the certificate request fails with a 404 that
# points at nothing in this file.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name {{ API_DOMAIN }};

    # certbot writes its challenge files here; this must stay reachable over
    # plain HTTP or renewal fails.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---- Port 443: the application ----
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{ API_DOMAIN }};

    ssl_certificate     /etc/letsencrypt/live/{{ API_DOMAIN }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ API_DOMAIN }}/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/{{ API_DOMAIN }}/chain.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    ssl_stapling on;
    ssl_stapling_verify on;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
{% else %}
# ---- Port 80 ----
# default_server so this also answers the load balancer's health check, which
# arrives addressed to this host's IP and matches no server_name.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name {{ API_DOMAIN }};

    # Honoured by browsers because the client's connection to the load balancer
    # is HTTPS, even though this hop is plain HTTP inside the private network.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
{% endif %}

    limit_req zone=api_limit burst={{ RATE_LIMIT_BURST }} nodelay;
    limit_req zone=api_burst burst={{ RATE_LIMIT_BURST_PER_SECOND }} nodelay;
    limit_conn conn_limit {{ MAX_CONCURRENT_CONNECTIONS }};

    client_max_body_size {{ MAX_BODY_SIZE }};
    client_body_buffer_size 128k;

    access_log /var/log/nginx/app-access.log main;
    error_log  /var/log/nginx/app-error.log warn;

    # ---- Health check ----
{% if TLS_LB %}
    # The load balancer health-checks this host BY IP, so the incoming Host is an
    # IP address. Frameworks that validate the Host header (FastAPI's
    # TrustedHostMiddleware, Django's ALLOWED_HOSTS) answer 400 to that, the LB
    # concludes the host is unhealthy and takes a perfectly good server out of
    # rotation. Sending a Host the app trusts is what prevents that; real client
    # traffic already carries the domain, so this changes nothing for it.
{% endif %}
    location {{ HEALTH_PATH }} {
        proxy_pass http://app_backend;
        proxy_set_header Host {{ proxy_host }};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        access_log off;
    }

    # ---- API documentation: basic auth, relaxed CSP for the Swagger CDN ----
    location ~ ^/(docs|redoc|openapi.json) {
        auth_basic "API documentation";
        # Created empty by deployctl, so this fails CLOSED (403) until an operator
        # puts a real htpasswd file there. See docs/30-OPERATIONS.md.
        auth_basic_user_file /etc/nginx/auth/.htpasswd;

        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: https:; font-src 'self' data: https://cdn.jsdelivr.net;" always;

        proxy_pass http://app_backend;
        proxy_http_version 1.1;
        proxy_set_header Host {{ proxy_host }};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $forwarded_port;
        proxy_set_header Connection "";
    }

    # ---- Project-supplied location blocks (project/nginx.extra.conf) ----
    include /etc/nginx/extra/*.conf;

    # ---- Everything else ----
    location / {
        # CORS is the application's job (it knows which origins are allowed);
        # adding headers here as well produces duplicates that browsers reject.
        proxy_pass http://app_backend;
        proxy_http_version 1.1;
        proxy_set_header Host {{ proxy_host }};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $forwarded_port;
        proxy_set_header Connection "";

        proxy_connect_timeout {{ PROXY_TIMEOUT }};
        proxy_send_timeout {{ PROXY_TIMEOUT }};
        proxy_read_timeout {{ PROXY_TIMEOUT }};

        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
        proxy_busy_buffers_size 8k;

        proxy_intercept_errors off;
        # Retry the next upstream only for connection-level failures. Note this
        # can replay a non-idempotent request, so it is deliberately limited.
        proxy_next_upstream error timeout invalid_header;
        proxy_next_upstream_tries 2;
        proxy_next_upstream_timeout 30s;
    }

    # Never serve dotfiles{% if TLS_LE %} (except the ACME challenge, handled on port 80){% endif %}.
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}
