# The app contract for a small FastAPI + Celery service — what a deploy directory's
# project/project.env looks like. `deployctl init` writes a commented stub of this.
APP_MODULE=app.main:app
APP_PORT=8000
HEALTH_PATH=/health
MIGRATE_CMD=alembic upgrade head
CELERY_APP=app.worker.celery_app
CELERY_QUEUES=default
DOCKERFILE=docker/Dockerfile
BUILD_CONTEXT=..
IMAGE_PLATFORM=linux/amd64
